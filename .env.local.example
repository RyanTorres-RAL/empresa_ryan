# Copie este arquivo para .env.local e preencha a chave de serviço.

# URL do projeto Supabase (público)
NEXT_PUBLIC_SUPABASE_URL=https://pbhkkejhiapcvfnsddin.supabase.co

# Chave publicável/anon — pode ficar no navegador: com RLS ligado e sem
# policies nas tabelas crm_*, ela não lê nem escreve nenhum dado do negócio.
# Serve apenas para login/logout e para ler a sessão atual.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XoK15X16RfNKJYt1XDoSZg_zfeAi8-E

# Chave service_role — SEGREDO. Só no servidor, nunca no navegador.
# Supabase Dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=__paste_from_supabase_dashboard_settings_api__
